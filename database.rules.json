{
  "rules": {
    "stats": {
      ".read": true,
      "$key": {
        ".write": "newData.exists() && $key.matches(/^(visits|soloGamesStarted|soloGamesFinished|onlineRooms|onlineJoins|onlineGamesStarted|onlineGamesFinished|bl_soloWins|bl_wisdomDraws|bl_cardsMade|og_visits|og_localStarted|og_localFinished|og_cpuStarted|og_cpuFinished|og_cpuGentle|og_cpuClassic|og_cpuSharp|og_onlineRooms|og_onlineJoins|og_onlineStarted|og_onlineFinished|og_goalsScored|stt_visits|stt_soloStarted|stt_soloFinished|stt_soloChill|stt_soloClever|stt_soloMaster|stt_soloDraw|stt_localStarted|stt_localFinished|stt_onlineRooms|stt_onlineJoins|stt_onlineStarted|stt_onlineFinished|stt_roundsPlayed|stt_stackPlayReached)$/)",
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "$code.matches(/^[A-Z]{4}$/)"
      }
    },
    "rooms": {
      "$code": {
        ".write": "auth != null && root.child('codes').child($code).val() === auth.uid",
        "meta": { ".read": "auth != null" },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('codes').child($code).exists()",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16" },
            "online": { ".validate": "newData.isBoolean()" }
          }
        },
        "state": { ".read": "auth != null" },
        "hands": {
          "$uid": { ".read": "auth != null && auth.uid === $uid" }
        },
        "secret": { ".read": "auth != null && root.child('codes').child($code).val() === auth.uid" },
        "actions": {
          ".read": "auth != null && root.child('codes').child($code).val() === auth.uid",
          "$a": {
            ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid"
          }
        }
      }
    }
  }
}
