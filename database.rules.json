{
  "rules": {
    "stats": {
      ".read": true,
      "$key": {
        ".write": "newData.exists() && $key.matches(/^(visits|uniqueVisitors|returningVisitors|returningSessions|bl_unique|og_unique|stt_unique|dev_mobile|dev_desktop|src_direct|src_google|src_tiktok|src_instagram|src_reddit|src_x|src_youtube|src_facebook|src_referral|sw_toBL|sw_toOG|sw_toSTT|soloGamesStarted|soloGamesFinished|onlineRooms|onlineJoins|onlineGamesStarted|onlineGamesFinished|bl_soloWins|bl_soloLosses|bl_soloTies|bl_wisdomDraws|bl_cardsMade|og_visits|og_localStarted|og_localFinished|og_cpuStarted|og_cpuFinished|og_cpuGentle|og_cpuClassic|og_cpuSharp|og_winGentle|og_lossGentle|og_winClassic|og_lossClassic|og_winSharp|og_lossSharp|og_redWins|og_blueWins|og_onlineRooms|og_onlineJoins|og_onlineStarted|og_onlineFinished|og_goalsScored|stt_visits|stt_soloStarted|stt_soloFinished|stt_soloChill|stt_soloClever|stt_soloMaster|stt_soloDraw|stt_winChill|stt_lossChill|stt_winClever|stt_lossClever|stt_winMaster|stt_lossMaster|stt_winDraw|stt_lossDraw|stt_localStarted|stt_localFinished|stt_onlineRooms|stt_onlineJoins|stt_onlineStarted|stt_onlineFinished|stt_roundsPlayed|stt_roundDraws|stt_stackPlayReached|stt_firstMoverWins|stt_secondMoverWins|stt_rWinChill|stt_rWinClever|stt_rWinMaster|stt_rWinDraw|stt_rLossChill|stt_rLossClever|stt_rLossMaster|stt_rLossDraw|stt_rDrawChill|stt_rDrawClever|stt_rDrawMaster|stt_rDrawDraw|og_gForGentle|og_gForClassic|og_gForSharp|og_gAgainstGentle|og_gAgainstClassic|og_gAgainstSharp)$/)",
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      }
    },
    "statsDaily": {
      ".read": true,
      "$day": {
        "$key": {
          ".write": "newData.exists() && $day.matches(/^\\d{4}-\\d{2}-\\d{2}$/) && $key.matches(/^(visits|dau|newUsers|retUsers|games|bl|og|stt)$/)",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "$code.matches(/^[A-Z]{4}$/)"
      }
    },
    "rooms": {
      "$code": {
        ".write": "auth != null && root.child('codes').child($code).val() === auth.uid",
        "meta": { ".read": "auth != null" },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('codes').child($code).exists()",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16" },
            "online": { ".validate": "newData.isBoolean()" }
          }
        },
        "state": { ".read": "auth != null" },
        "hands": {
          "$uid": { ".read": "auth != null && auth.uid === $uid" }
        },
        "secret": { ".read": "auth != null && root.child('codes').child($code).val() === auth.uid" },
        "actions": {
          ".read": "auth != null && root.child('codes').child($code).val() === auth.uid",
          "$a": {
            ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid"
          }
        }
      }
    }
  }
}
